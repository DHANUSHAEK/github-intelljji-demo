import java.util.*;
public class MaximumProductArray {
    public static void main(String[] args) {
        List<String> list = new ArrayList<>();
        list.add("abcw");
        list.add("baz");
        list.add("foo");
        list.add("bar");
        list.add("xtfn");
        list.add("abcdef");
        int max_value=0;
        for (int loop = 0; loop < list.size(); loop++) {
            int num = list.get(loop).length();
            char[] ch = new char[num];
            String word = list.get(loop);
            for (int i = 0; i < num; i++) {
                ch[i] = word.charAt(i);
            }
            for (int j = loop + 1; j < list.size(); j++) {

                boolean result = false;
                String word2 = list.get(j);

                for (char c1 : ch) {
                    for (char c2 : word2.toCharArray()) {

                        if (c1 == c2) {
                            result = true;
                            break;
                        }

                    }
                }
                    int total = word.length() * word2.length();
                    if (total > max_value) {
                        max_value = total;
                    }
                }
                }
            }
        System.out.println(max_value);
        }
    }
